{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Mindhárom feladat futtatása (1. Check + 2. Det + 3. Mini)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/python-starter/run_all.py",
            "cwd": "${workspaceFolder}/python-starter",
            "console": "integratedTerminal"
        },
        {
            "name": "1. Feladat: DFA Check (python -m project)",
            "type": "debugpy",
            "request": "launch",
            "module": "project",
            "cwd": "${workspaceFolder}/python-starter",
            "args": [
                "--input", "bemenet.txt",
                "--output", "kimenet.txt",
                "--check", "10101,111,001"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "2. Feladat: DFA Determinize (python -m project)",
            "type": "debugpy",
            "request": "launch",
            "module": "project",
            "cwd": "${workspaceFolder}/python-starter",
            "args": [
                "--input", "bemenet_nfa.txt",
                "--output", "kimenet.txt",
                "--det"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "3. Feladat: DFA Minimize (python -m project)",
            "type": "debugpy",
            "request": "launch",
            "module": "project",
            "cwd": "${workspaceFolder}/python-starter",
            "args": [
                "--input", "bemenet_mini.txt",
                "--output", "kimenet.txt",
                "--mini"
            ],
            "console": "integratedTerminal"
        }
    ]
}
