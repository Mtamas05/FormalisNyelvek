{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Mind a 4 feladat futtatása (1. Check + 2. Det + 3. Mini + 4. Regex)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/python-starter/run_all.py",
            "cwd": "${workspaceFolder}/python-starter",
            "console": "integratedTerminal"
        },
        {
            "name": "1. Feladat: DFA Check (python -m project)",
            "type": "debugpy",
            "request": "launch",
            "module": "project",
            "cwd": "${workspaceFolder}/python-starter",
            "args": [
                "--input", "bemenet.txt",
                "--output", "kimenet.txt",
                "--check", "10101,111,001"
            ],
            "console": "integratedTerminal"
        },
